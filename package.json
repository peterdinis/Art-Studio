{
	"name": "art-studio",
	"version": "0.8.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"biome:check": "biome check .",
		"biome:check-fix": "biome check --apply .",
		"biome:check-unsafe": "biome check --apply-unsafe .",
		"biome:format": "biome format .",
		"format-fix": "biome format --write .",
		"biome:ci": "biome ci .",
		"biome:lint": "biome lint .",
		"biome:lint-fix": "biome lint --apply .",
		"biome:lint-unsafe": "biome lint --apply-unsafe .",
		"format": "bun run biome:format-fix && bun run biome:check-fix",
		"lint:all": "bun run biome:lint && bun run biome:check",
		"lint:fix": "bun run biome:lint-fix && bun run biome:check-fix",
		"lint:ci": "bun run biome:ci",
		"test": "vitest run"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-tooltip": "^1.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"critters": "^0.0.25",
		"date-fns": "^4.1.0",
		"fabric": "^7.3.1",
		"framer-motion": "^12.38.0",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"konva": "^10.3.0",
		"lucide-react": "^0.562.0",
		"next": "^16.2.4",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-konva": "^19.2.3",
		"react-resizable-panels": "^4.10.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"vaul": "^1.1.2",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@tailwindcss/postcss": "^4.2.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20.19.39",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"babel-plugin-react-compiler": "1.0.0",
		"jsdom": "^27.4.0",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
